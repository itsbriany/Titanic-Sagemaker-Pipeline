{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Titanic - Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": ["--validate-only"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_DEFAULT_REGION": "us-east-1",
        "TITANIC_PIPELINE_BUCKET": "replace-with-your-s3-bucket",
        "DEPLOYMENT_LAMBDA_SSM_PARAMETER": "/titanic-pipeline/deployment-lambda/arn"
      }
    },
    {
      "name": "Titanic - Preprocess",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/preprocessing.py",
      "args": ["--input-dir", "${workspaceFolder}/data"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    },
    {
      "name": "Titanic - Train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--input-dir", "/opt/ml/processing/train"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    },
    {
      "name": "Titanic - Evaluate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": [
        "--model-dir",
        "/home/sagemaker-user/projects/titanic-pipeline/data/model"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    },
    {
      "name": "Titanic - Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-vv", "-s"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    }
  ]
}
